<?xml version="1.0" encoding="utf-8"?>
<!--
  App mark: a rupee glyph (the app is INR-only) drawn as strokes.

  Built from the classic rupee construction: a top bar, a bowl closing back onto
  the left stem, a second bar that overhangs to the left (the feature that
  distinguishes ₹ from R), and a diagonal leg.

  Everything sits inside the 21..87 safe zone of the 108dp canvas so no mask
  shape can clip it.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Top bar + bowl, drawn as one stroke -->
    <path
        android:pathData="M41,32 L72,32 C78,32 78,50 72,50 L41,50"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="7.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round" />

    <!-- Left stem tying the two bars together -->
    <path
        android:pathData="M41,32 L41,50"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="7.5"
        android:strokeLineCap="round" />

    <!-- Second bar, overhanging left: the rupee double-bar -->
    <path
        android:pathData="M33,50 L72,50"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="7.5"
        android:strokeLineCap="round" />

    <!-- Diagonal leg -->
    <path
        android:pathData="M47,50 L73,80"
        android:strokeColor="#FFFFFFFF"
        android:strokeWidth="7.5"
        android:strokeLineCap="round" />

</vector>