<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- SMS permissions only in personalSms flavor -->
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <!-- SMS capture needs telephony, but the app must still install on
         devices without it (tablets, ChromeOS) so manual and CSV import work. -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <application>
        <receiver
            android:name=".data.sms.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
